{
    "$schema": "https://opencode.ai/config.json",

    "tools": {
        "websearch": true,
        "codesearch": true
    },

    "plugin": ["@dietrichgebert/ponytail"],

    "lsp": true,

    "agent": {
        "build": {
            "mode": "primary",
            "model": "opencode/deepseek-v4-flash-free",
            "permission": { "edit": "allow", "bash": "ask" }
        },
        "plan": {
            "mode": "primary",
            "model": "sail-research/zai-org/GLM-5.2-FP8",
            "permission": { "edit": "deny", "bash": "deny" }
        },
        "explore": {
            "mode": "subagent",
            "model": "opencode/deepseek-v4-flash-free"
        }
    },

    "provider": {
        "sail-research": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Sail Research",
            "options": {
                "baseURL": "https://api.sailresearch.com/v1",
                "apiKey": "{env:SAIL_RESEARCH_API_KEY}"
            },
            "models": {
                "zai-org/GLM-5.2-FP8": {
                    "name": "GLM-5.2-FP8",
                    "options": {
                        "metadata": {
                            "completion_window": "standard"
                        }
                    }
                },
                "openai/gpt-oss-120b": {
                    "name": "gpt-oss-120b",
                    "options": {
                        "metadata": {
                            "completion_window": "priority"
                        }
                    }
                }
            }
        }
    }
}
